# 入口：Posit Connect Cloud（雲端版）以本檔為 primary file，回傳 Shiny app 物件
# （不可呼叫 runApp）。本機：shiny::runApp(本資料夾)，或安裝成套件後 {{package}}::run_app()。

# 必須在載入 R/ 之前設定，避免 Shiny 自動 source R/ 到錯誤的環境
options(shiny.autoload.r = FALSE)

# 載入 R/ 的所有函式到獨立環境（不污染使用者的 global environment）
app_env <- new.env(parent = globalenv())
for (f in sort(list.files("R", pattern = "[.]R$", full.names = TRUE))) {
  source(f, local = app_env, encoding = "UTF-8")
}

shiny::shinyApp(app_env$app_ui, app_env$app_server)
